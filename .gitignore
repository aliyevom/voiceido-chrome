# --- Dependencies & build output -------------------------------------------
node_modules/
dist/
release/
*.tsbuildinfo

# --- Local-only docs / scratch ---------------------------------------------
# README2.md is an internal long-form notes file kept off the public repo.
README2.md
NOTES.md
TODO.md
*.scratch.md

# --- Logs ------------------------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*

# --- OS / editor cruft -----------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/

# --- Environment / secrets -------------------------------------------------
# Never commit real API keys or service-account JSON. Keep `.env.example`
# checked in so contributors know what variables exist.
.env
.env.*
!.env.example
*.pem
*.key
service-account*.json
credentials*.json

# --- Packaging artifacts ---------------------------------------------------
*.zip
*.tar.gz
